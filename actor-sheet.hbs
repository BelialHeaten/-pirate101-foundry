<form class="p101-sheet flexcol" autocomplete="off">
<header class="p101-header"><img class="profile-img" src="{{actor.img}}" data-edit="img" title="Portrait" width="76" height="76"/><div><input name="name" value="{{actor.name}}" placeholder="Name"/><div class="p101-meta"><label>Class <select name="system.class">{{selectOptions classes selected=system.class}}</select></label><label>Level <input type="number" name="system.level" value="{{system.level}}"/></label><label>XP <input type="number" name="system.experience" value="{{system.experience}}"/></label></div><div class="p101-health">HP <input type="number" name="system.health.value" value="{{system.health.value}}"/> / {{derived.health.max}}</div></div></header>
<nav class="p101-tabs"><button type="button" data-tab="stats" class="active">Stats</button><button type="button" data-tab="equipment">Equipment</button><button type="button" data-tab="powers">Powers</button><button type="button" data-tab="talents">Talents</button><button type="button" data-tab="notes">Notes</button></nav>
<section class="p101-content"><div class="p101-panel" data-panel="stats"><p class="p101-hint">Base values are editable; Total includes active item and effect modifiers.</p><div class="p101-statgrid">{{#each statRows as |s|}}<label>{{s.label}}<input type="number" name="system.base.{{s.key}}" value="{{s.base}}"/><strong>{{s.total}}</strong></label>{{/each}}</div></div>
<div class="p101-panel" data-panel="equipment" hidden><div class="p101-paneltop"><strong>Weapons & Equipment</strong><button type="button" data-create="equipment">+ Equipment</button><button type="button" data-create="weapon">+ Weapon</button></div>{{#each equipment as |item|}}<div class="p101-item"><img src="{{item.img}}" width="28" height="28"/><a data-open="{{item.id}}">{{item.name}}</a><small>{{item.slot}}</small><small>{{item.bonuses}}</small>{{#if (eq item.type "weapon")}}<button type="button" data-attack="{{item.id}}" title="Attack targeted token; automatic HP changes are optional in system settings">Attack</button>{{/if}}<label><input type="checkbox" data-equip="{{item.id}}" {{#if item.equipped}}checked{{/if}}/> Equipped</label><button type="button" data-delete="{{item.id}}">×</button></div>{{/each}}</div>
<div class="p101-panel" data-panel="powers" hidden><div class="p101-paneltop"><strong>Powers</strong><button type="button" data-create="power">+ Power</button></div>{{#each powers as |item|}}<div class="p101-item"><img src="{{item.img}}" width="28" height="28"/><a data-open="{{item.id}}">{{item.name}}</a><button type="button" data-delete="{{item.id}}">×</button></div>{{/each}}</div>
<div class="p101-panel" data-panel="talents" hidden><div class="p101-paneltop"><strong>Epic Talents</strong><button type="button" data-create="talent">+ Talent</button></div>{{#each talents as |item|}}<div class="p101-item"><img src="{{item.img}}" width="28" height="28"/><a data-open="{{item.id}}">{{item.name}} (Rank {{item.system.rank}})</a><button type="button" data-delete="{{item.id}}">×</button></div>{{/each}}</div>
<div class="p101-panel" data-panel="notes" hidden><textarea name="system.notes">{{system.notes}}</textarea></div></section>
</form>
